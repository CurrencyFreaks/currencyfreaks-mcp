{
  "name": "@currencyfreaks/mcp",
  "version": "1.0.0",
  "description": "Official MCP server for CurrencyFreaks — real-time and historical exchange rates and currency conversion for 1000+ fiat, crypto, and metal currencies as MCP tools for Claude, Cursor, Windsurf, and any MCP client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "currency",
    "exchange-rates",
    "forex",
    "currency-converter",
    "currencyfreaks",
    "claude",
    "ai-tools"
  ],
  "homepage": "https://currencyfreaks.com",
  "bugs": "https://github.com/CurrencyFreaks/currencyfreaks-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurrencyFreaks/currencyfreaks-mcp.git"
  },
  "license": "MIT",
  "author": "CurrencyFreaks",
  "type": "module",
  "bin": {
    "currencyfreaks-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
